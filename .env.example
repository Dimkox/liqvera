# multi-exchange-engine — never commit real secrets

# Hyperliquid
HL_ACCOUNT_ADDRESS=
HL_API_WALLET_PRIVATE_KEY=          # agent wallet, no withdraw rights
HL_BUILDER_CODE=

# Lighter
LIGHTER_ACCOUNT_INDEX=
LIGHTER_API_KEY_PRIVATE_KEY=
LIGHTER_API_KEY_INDEX=4             # 0-3 reserved by frontend
LIGHTER_NETWORK=mainnet             # or testnet

# Bybit (later)
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=false

# Risk defaults
MAX_ORDER_NOTIONAL_USD=100
MAX_NET_DELTA_USD=50
MAX_UNHEDGED_SECONDS=30
DAILY_LOSS_LIMIT_USD=50
KILL_SWITCH=false

# Runtime
LOG_LEVEL=INFO
DRY_RUN=true
