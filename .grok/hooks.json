{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 tooling/run-adaptive-grok.py --hook session_start.py",
            "commandWindows": "python tooling/run-adaptive-grok.py --hook session_start.py",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 tooling/run-adaptive-grok.py --hook user_prompt_submit.py",
            "commandWindows": "python tooling/run-adaptive-grok.py --hook user_prompt_submit.py",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 tooling/run-adaptive-grok.py --hook pre_tool_use.py",
            "commandWindows": "python tooling/run-adaptive-grok.py --hook pre_tool_use.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 tooling/run-adaptive-grok.py --hook post_tool_use.py",
            "commandWindows": "python tooling/run-adaptive-grok.py --hook post_tool_use.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 tooling/run-adaptive-grok.py --hook pre_compact.py",
            "commandWindows": "python tooling/run-adaptive-grok.py --hook pre_compact.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 tooling/run-adaptive-grok.py --hook subagent_start.py",
            "commandWindows": "python tooling/run-adaptive-grok.py --hook subagent_start.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 tooling/run-adaptive-grok.py --hook subagent_stop.py",
            "commandWindows": "python tooling/run-adaptive-grok.py --hook subagent_stop.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 tooling/run-adaptive-grok.py --hook stop_gate.py",
            "commandWindows": "python tooling/run-adaptive-grok.py --hook stop_gate.py",
            "timeout": 120
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 tooling/run-adaptive-grok.py --hook session_end.py",
            "commandWindows": "python tooling/run-adaptive-grok.py --hook session_end.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
