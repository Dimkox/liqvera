{
  "name": "mee-mezo-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.14.0 <25" },
  "scripts": {
    "build": "tsc && node scripts/copy-resources.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && tsc -p tsconfig.test.json && node scripts/copy-resources.mjs --test && node --test test-dist/test/*.test.js test/*.test.mjs",
    "test:postgres": "npm run build && tsc -p tsconfig.test.json && node --test test-dist/test/postgres.test.js",
    "start": "node dist/main.js",
    "migrate": "node dist/migrate.js",
    "p3-operator": "node dist/p3-operator.js"
  },
  "dependencies": {
    "@liqvera/mezo-protocol": "file:../../packages/mezo-protocol",
    "@x402/core": "2.16.0",
    "@x402/evm": "2.16.0",
    "@x402/express": "2.16.0",
    "@x402/extensions": "2.16.0",
    "@x402/paywall": "2.16.0",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "express": "5.1.0",
    "pg": "8.16.3",
    "viem": "2.48.11"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "typescript": "5.9.2"
  },
  "overrides": {
    "@x402/core": "2.16.0", "@x402/evm": "2.16.0", "@x402/express": "2.16.0",
    "@x402/paywall": "2.16.0", "@x402/extensions": "2.16.0"
  }
}
