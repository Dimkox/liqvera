[Unit]
Description=MEE controller owned-resource reconciliation
After=network.target

[Service]
Type=oneshot
User=claw-engine-runner
Environment=RUNNER_NAME=claw-engine-runner
ExecStart=/usr/local/libexec/mee-controller-reconcile
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/mee-controller
