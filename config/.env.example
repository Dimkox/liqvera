ENGINE_MODE=shadow
LIVE_EXECUTION_ENABLED=false
HTTP_ADDR=:8080
DATABASE_URL=postgres://engine:change-me@postgres:5432/engine?sslmode=disable

# Lighter: use read-only auth for the current shadow stage.
LIGHTER_BASE_URL=https://mainnet.zklighter.elliot.ai
LIGHTER_AUTH_MODE=read_only
LIGHTER_L1_ADDRESS=
LIGHTER_ACCOUNT_INDEX=
LIGHTER_API_KEY_INDEX=
LIGHTER_API_PUBLIC_KEY=
LIGHTER_API_PRIVATE_KEY=
LIGHTER_READ_ONLY_TOKEN=
LIGHTER_READ_ONLY_TOKEN_EXPIRES_AT=
LIGHTER_API_MAKER_ONLY=false

# Hyperliquid venue identity. Use an authorized agent key, never the main wallet key.
HYPERLIQUID_ACCOUNT_ADDRESS=
HYPERLIQUID_AGENT_ADDRESS=
HYPERLIQUID_PRIVATE_KEY=

# Extended/X10 credentials imported only when that adapter is implemented.
EXTENDED_BASE_URL=
EXTENDED_API_KEY=
EXTENDED_ACCOUNT_ID=
EXTENDED_CLIENT_ID=
EXTENDED_STARK_PUBLIC_KEY=
EXTENDED_VAULT_ID=
EXTENDED_BUILDER_FEE_RATE=

# MEXC credentials currently belong to the isolated test configuration.
MEXC_API_BASE=
MEXC_ACCESS_KEY=
MEXC_SECRET_KEY=
MEXC_TEST_MODE=true

# Telegram delivery only; application/admin/JWT secrets are separate concerns.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
TELEGRAM_SOCKS_PROXY_URL=
TELEGRAM_DELIVERY_MODE=

# This release rejects live execution even if venue write credentials exist.
