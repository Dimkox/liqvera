{
    http_port 8080
    https_port 8443
}

{$LIQVERA_SITE_ADDRESS} {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
        -Server
    }

    @api path /healthz /readyz /v1/*
    handle @api {
        reverse_proxy gateway:8080
    }
    handle {
        reverse_proxy web:8083
    }
}
