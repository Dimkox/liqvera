# syntax=docker/dockerfile:1
FROM python:3.12.13-slim-bookworm AS wheels
WORKDIR /src
COPY packages/contracts packages/contracts
COPY packages/public-capture packages/public-capture
RUN python -m pip wheel --no-cache-dir --wheel-dir /wheels \
    ./packages/contracts ./packages/public-capture

FROM python:3.12.13-slim-bookworm
COPY --from=wheels /wheels /wheels
RUN python -m pip install --no-cache-dir --no-index --find-links=/wheels mee-public-capture==0.1.0 \
    && rm -rf /wheels \
    && groupadd --system --gid 10001 liqvera \
    && useradd --system --uid 10001 --gid 10001 --home-dir /nonexistent liqvera \
    && mkdir -p /data/captures \
    && chown 10001:10001 /data/captures
USER 10001:10001
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 LIQVERA_CAPTURE_PORT=8081 LIQVERA_CAPTURE_ROOT=/data/captures
EXPOSE 8081
CMD ["python", "-B", "-m", "mee_public_capture.evidence_service"]
