# syntax=docker/dockerfile:1
FROM python:3.12.15-alpine3.23@sha256:1fd55c2f838c4f76262f9eeed899ff9168ea96ac383c61667d6f204325e1f169 AS wheels
RUN apk add --no-cache zlib=1.3.2-r1
WORKDIR /src
COPY requirements.lock /src/requirements.lock
COPY packages/contracts packages/contracts
COPY packages/public-capture packages/public-capture
RUN python -m pip wheel --no-cache-dir --constraint requirements.lock --wheel-dir /wheels \
    ./packages/contracts ./packages/public-capture

FROM python:3.12.15-alpine3.23@sha256:1fd55c2f838c4f76262f9eeed899ff9168ea96ac383c61667d6f204325e1f169
RUN apk add --no-cache zlib=1.3.2-r1
COPY --from=wheels /wheels /wheels
RUN python -m pip install --no-cache-dir --no-index --find-links=/wheels liqvera-public-capture==0.2.0 \
    && python -m pip uninstall -y pip && rm -rf /usr/local/lib/python3.12/ensurepip /wheels \
    && addgroup -S -g 10001 liqvera \
    && adduser -S -D -H -u 10001 -G liqvera liqvera \
    && mkdir -p /data/captures \
    && chown 10001:10001 /data/captures \
    && chmod 0750 /data/captures
USER 10001:10001
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 LIQVERA_CAPTURE_PORT=8081 LIQVERA_CAPTURE_ROOT=/data/captures
EXPOSE 8081
CMD ["python", "-B", "-m", "liqvera_public_capture.evidence_service"]
