# syntax=docker/dockerfile:1
FROM caddy:2-alpine
RUN apk add --no-cache libcap \
    && setcap -r /usr/bin/caddy \
    && apk del libcap \
    && mkdir -p /data /config \
    && chown -R 10001:10001 /data /config
USER 10001:10001
EXPOSE 8080 8443
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
