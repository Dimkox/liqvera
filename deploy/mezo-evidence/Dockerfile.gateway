# syntax=docker/dockerfile:1
FROM alpine:3.24@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6 AS busybox-security
RUN apk add --no-cache ca-certificates=20261020-r0 ca-certificates-bundle=20261020-r0 alpine-sdk perl linux-headers openssl-dev utmps-dev utmps-static zip
COPY deploy/security/busybox/build.sh deploy/security/busybox/wget-CVE-2025-60876.patch /backport/
RUN sh /backport/build.sh

FROM node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402 AS build
RUN apk add --no-cache ca-certificates=20261020-r0 ca-certificates-bundle=20261020-r0
ENV NODE_OPTIONS=--use-openssl-ca
WORKDIR /workspace
COPY packages/mezo-protocol/ packages/mezo-protocol/
COPY schemas/mezo-evidence/v1 schemas/mezo-evidence/v1/
COPY apps/mezo-gateway/package.json apps/mezo-gateway/package-lock.json apps/mezo-gateway/
WORKDIR /workspace/apps/mezo-gateway
RUN npm ci --ignore-scripts
RUN ./node_modules/.bin/tsc -p ../../packages/mezo-protocol/tsconfig.json
COPY apps/mezo-gateway/ ./
RUN npm run build

FROM build AS production-dependencies
RUN npm prune --omit=dev --ignore-scripts

FROM alpine:3.24@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
# Alpine's Node LTS links patched system OpenSSL and uses explicit system trust.
# Keep the runtime pin available in the selected Alpine repository.
RUN apk add --no-cache musl=1.2.6-r3 musl-utils=1.2.6-r3 ca-certificates=20261020-r0 ca-certificates-bundle=20261020-r0 nodejs=24.22.1-r0 zlib=1.3.2-r1 libcrypto3=3.5.9-r0 libssl3=3.5.9-r0
ENV NODE_ENV=production PORT=8080 HOME=/tmp NODE_OPTIONS=--use-openssl-ca
WORKDIR /workspace
COPY --from=build /workspace/packages/mezo-protocol packages/mezo-protocol/
COPY apps/mezo-gateway/package.json apps/mezo-gateway/package-lock.json apps/mezo-gateway/
WORKDIR /workspace/apps/mezo-gateway
COPY --from=production-dependencies /workspace/apps/mezo-gateway/node_modules ./node_modules
COPY --from=build /workspace/apps/mezo-gateway/dist ./dist
COPY --from=build /workspace/apps/mezo-gateway/migrations ./migrations
COPY deploy/mezo-evidence/gateway-entrypoint.js /app/gateway-entrypoint.js
COPY deploy/mezo-evidence/db-loopback-proxy.js /app/db-loopback-proxy.js
# Install only after APK operations, which may replace the vendor binary.
COPY --from=busybox-security /out/busybox /bin/busybox
COPY --from=busybox-security /out/busybox.sha256 /out/original-applets.txt /out/patched-applets.txt /out/LICENSE /out/busybox-corresponding-source.tar.gz /usr/local/share/liqvera-security/busybox/
RUN sed -i 's#/out/busybox#/bin/busybox#' /usr/local/share/liqvera-security/busybox/busybox.sha256 \
    && sha256sum -c /usr/local/share/liqvera-security/busybox/busybox.sha256
USER 10003:10001
EXPOSE 8080
CMD ["node", "/app/gateway-entrypoint.js"]
