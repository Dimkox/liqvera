# syntax=docker/dockerfile:1
FROM node:22-alpine AS build
WORKDIR /app
COPY apps/mezo-gateway/package.json apps/mezo-gateway/package-lock.json ./
RUN npm ci
COPY apps/mezo-gateway/ ./
RUN npm run build

FROM node:22-alpine
ENV NODE_ENV=production PORT=8080
WORKDIR /app
COPY apps/mezo-gateway/package.json apps/mezo-gateway/package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=build /app/dist ./dist
COPY --from=build /app/migrations ./migrations
COPY deploy/mezo-evidence/gateway-entrypoint.js /app/gateway-entrypoint.js
USER node
EXPOSE 8080
CMD ["node", "/app/gateway-entrypoint.js"]
