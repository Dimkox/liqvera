# syntax=docker/dockerfile:1
FROM python:3.12.15-alpine3.23@sha256:1fd55c2f838c4f76262f9eeed899ff9168ea96ac383c61667d6f204325e1f169 AS wheels
RUN apk add --no-cache zlib=1.3.2-r1
WORKDIR /src
COPY requirements.lock /src/requirements.lock
COPY packages/contracts packages/contracts
COPY packages/public-capture packages/public-capture
COPY packages/readonly-analyzer packages/readonly-analyzer
COPY packages/evidence-report packages/evidence-report
COPY schemas/mezo-evidence/v1 schemas/mezo-evidence/v1
COPY web web
COPY scripts/run-mvp-web.py scripts/run-mvp-web.py
RUN python -m pip wheel --no-cache-dir --constraint requirements.lock --wheel-dir /wheels \
    ./packages/contracts ./packages/public-capture ./packages/readonly-analyzer ./packages/evidence-report

FROM python:3.12.15-alpine3.23@sha256:1fd55c2f838c4f76262f9eeed899ff9168ea96ac383c61667d6f204325e1f169
RUN apk add --no-cache zlib=1.3.2-r1
COPY --from=wheels /wheels /wheels
RUN python -m pip install --no-cache-dir --no-index --find-links=/wheels liqvera-evidence-report==0.2.0 \
    && python -m pip uninstall -y pip && rm -rf /usr/local/lib/python3.12/ensurepip /wheels \
    && addgroup -S -g 10001 liqvera \
    && adduser -S -D -H -u 10002 -G liqvera liqvera-report \
    && mkdir -p /data/artifacts \
    && chown 10002:10001 /data/artifacts \
    && chmod 0750 /data/artifacts
USER 10002:10001
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 LIQVERA_REPORT_PORT=8082 LIQVERA_CAPTURE_ROOT=/data/captures LIQVERA_ARTIFACT_ROOT=/data/artifacts
EXPOSE 8082
CMD ["python", "-B", "-m", "liqvera_evidence_report.service"]
