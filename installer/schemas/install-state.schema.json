{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liqvera.example/schemas/liqvera-install-state-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product_version", "release_sha256", "git_commit", "git_tree", "install_root", "compose_project", "linux", "docker", "ports", "last_completed_phase", "last_error", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"const": "liqvera-install-state/v1"},
    "product_version": {"const": "0.0.2"},
    "release_sha256": {"$ref": "#/$defs/sha256"},
    "git_commit": {"$ref": "#/$defs/git_oid"},
    "git_tree": {"$ref": "#/$defs/git_oid"},
    "install_root": {"type": "string", "minLength": 2, "maxLength": 4096, "pattern": "^/[^\\n\\r\\u0000]+$"},
    "compose_project": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"},
    "linux": {
      "type": "object", "additionalProperties": false,
      "required": ["distribution", "architecture"],
      "properties": {"distribution": {"enum": ["ubuntu", "debian", "fedora", "rhel"]}, "architecture": {"enum": ["amd64", "arm64"]}}
    },
    "docker": {
      "type": "object", "additionalProperties": false,
      "required": ["engine_version", "compose_version"],
      "properties": {"engine_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}, "compose_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}}
    },
    "ports": {
      "type": "object", "additionalProperties": false,
      "required": ["web", "gateway", "metrics"],
      "properties": {"web": {"const": 3000}, "gateway": {"const": 8080}, "metrics": {"const": 9090}}
    },
    "last_completed_phase": {"enum": ["PREFLIGHT", "VERIFIED", "CONFIGURED", "MIGRATED", "HEALTHY", "STOPPED", "UNINSTALLED"]},
    "last_error": {"type": ["string", "null"], "enum": [null, "UNSUPPORTED_LINUX", "DEPENDENCY_MISSING", "UNSAFE_INSTALL_ROOT", "PORT_OCCUPIED", "RELEASE_DIGEST_MISMATCH", "ARCHIVE_INVALID", "CONFIG_INVALID", "SECRET_REFERENCE_INVALID", "MIGRATION_MISMATCH", "HEALTH_TIMEOUT", "ROLLBACK_RESTORE_REQUIRED", "PURGE_CONFIRMATION_REQUIRED"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "git_oid": {"type": "string", "minLength": 40, "maxLength": 40, "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"}
  }
}
