{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liqvera.example/schemas/liqvera-installer-release-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product_version", "git_commit", "git_tree", "compose_sha256", "launchers", "images", "migrations", "database_compatibility", "supported_linux"],
  "properties": {
    "schema_version": {"const": "liqvera-installer-release/v1"},
    "product_version": {"const": "0.0.2"},
    "git_commit": {"$ref": "#/$defs/git_oid"},
    "git_tree": {"$ref": "#/$defs/git_oid"},
    "compose_sha256": {"$ref": "#/$defs/sha256"},
    "launchers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["install.sh", "liqvera.sh"],
      "properties": {
        "install.sh": {"$ref": "#/$defs/sha256"},
        "liqvera.sh": {"$ref": "#/$defs/sha256"}
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edge", "web", "gateway", "capture", "report", "postgres"],
      "properties": {
        "edge": {"$ref": "#/$defs/image"},
        "web": {"$ref": "#/$defs/image"},
        "gateway": {"$ref": "#/$defs/image"},
        "capture": {"$ref": "#/$defs/image"},
        "report": {"$ref": "#/$defs/image"},
        "postgres": {"$ref": "#/$defs/image"}
      }
    },
    "migrations": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        {"$ref": "#/$defs/migration_001"},
        {"$ref": "#/$defs/migration_002"},
        {"$ref": "#/$defs/migration_003"},
        {"$ref": "#/$defs/migration_004"},
        {"$ref": "#/$defs/migration_005"}
      ],
      "items": false
    },
    "database_compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted_migrations", "down_migrations"],
      "properties": {
        "accepted_migrations": {"$ref": "#/properties/migrations"},
        "down_migrations": {"const": false}
      }
    },
    "supported_linux": {
      "type": "object",
      "additionalProperties": false,
      "required": ["architectures", "distributions"],
      "properties": {
        "architectures": {"const": ["amd64", "arm64"]},
        "distributions": {"const": ["ubuntu", "debian", "fedora", "rhel"]}
      }
    }
  },
  "$defs": {
    "git_oid": {"type": "string", "minLength": 40, "maxLength": 40, "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"},
    "image": {"type": "string", "pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}(?![\\s\\S])"},
    "migration_001": {"const": {"name": "001_ledger.sql", "sha256": "bc127e55c876961112f33ca2abdfac01827769d6156ddba2f42856d070c75b3b"}},
    "migration_002": {"const": {"name": "002_fix_immutable_ledger_identity.sql", "sha256": "981f48215e64fdd0fb72be5a6df78238cf8050de722adb454b4e28b1940ccbcb"}},
    "migration_003": {"const": {"name": "003_live_grant_consumption.sql", "sha256": "bbedff6137a648166b77233c56a466e46247480b404b8829b64f29123109bcf0"}},
    "migration_004": {"const": {"name": "004_receipt_confirmation_provenance.sql", "sha256": "96bba00d344d81670a4c0f8741186004910e959f374ecd77ce78268d52fd465a"}},
    "migration_005": {"const": {"name": "005_receipt_confirmation_count.sql", "sha256": "e99e5cffab60c08dfb1cd73d13caf2915f31aec542c26c87b016d0e125a23b11"}}
  }
}
