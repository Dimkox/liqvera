[Unit]
Description=Liqvera shadow stack
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=@INSTALL_ROOT@/liqvera.sh --install-root @INSTALL_ROOT@ start
ExecStop=@INSTALL_ROOT@/liqvera.sh --install-root @INSTALL_ROOT@ stop
NoNewPrivileges=yes

[Install]
WantedBy=default.target
