{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authority", "not_host_receipt", "repository", "controller_sha", "controller_tree", "install_manifest_sha256", "artifact_count", "status", "created_at"],
  "properties": {
    "schema_version": {"const": "claw-host-deployment-d0-receipt-v1"},
    "authority": {"const": "NONE"},
    "not_host_receipt": {"const": true},
    "repository": {"const": "Dimkox/multi-exchange-engine"},
    "controller_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "controller_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "install_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact_count": {"type": "integer", "minimum": 1, "maximum": 32},
    "status": {"const": "D0_VERIFIED"},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
