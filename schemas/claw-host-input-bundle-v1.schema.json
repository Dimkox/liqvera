{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Dimkox/multi-exchange-engine/schemas/claw-host-input-bundle-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "assets"],
  "properties": {
    "schema_version": {"const": "claw-host-input-bundle-v1"},
    "assets": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "role", "size", "sha256"],
        "properties": {
          "id": {"type": "integer", "minimum": 1},
          "name": {"type": "string", "pattern": "^[A-Za-z0-9_.:+-]{1,180}$"},
          "role": {"type": "string", "pattern": "^(host_inventory|oci_archive|oci_layout|oci_receipt|oci_sidecar|deb:[a-z0-9][a-z0-9+.-]{0,127})$"},
          "size": {"type": "integer", "minimum": 1, "maximum": 536870912},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
