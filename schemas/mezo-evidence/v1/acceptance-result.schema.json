{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.liqvera.invalid/mezo-evidence/v1/acceptance-result.schema.json",
  "title": "Liqvera A01–A30 acceptance result",
  "description": "A result records observed assertions against one clean commit. PASS is permitted only for an executed command with a retained, hashed evidence file; it is not a release approval.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "mode", "repository", "environment", "started_at", "ended_at", "overall_status", "cases"],
  "properties": {
    "schema": {"const": "liqvera-acceptance-result/v1"},
    "mode": {"enum": ["offline", "live"]},
    "repository": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "origin", "commit", "tree", "worktree"],
      "properties": {
        "repository": {"const": "Dimkox/liqvera"},
        "origin": {"enum": ["github.com/Dimkox/liqvera", "UNSET"]},
        "commit": {"$ref": "#/$defs/sha256"},
        "tree": {"$ref": "#/$defs/sha256"},
        "worktree": {"const": "CLEAN"}
      }
    },
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["platform", "python"],
      "properties": {
        "platform": {"type": "string", "minLength": 1},
        "python": {"type": "string", "minLength": 1}
      }
    },
    "started_at": {"$ref": "#/$defs/time"},
    "ended_at": {"$ref": "#/$defs/time"},
    "overall_status": {"enum": ["PASS", "FAIL", "INCOMPLETE"]},
    "cases": {"type": "array", "minItems": 30, "maxItems": 30, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "time": {"type": "string", "format": "date-time"},
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["file", "sha256", "size_bytes"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0, "maximum": 10000000}
      }
    },
    "payment": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["tx_hash", "block_hash", "log_index", "buyer", "merchant", "network", "asset", "amount_atomic"],
          "properties": {
            "tx_hash": {"type": "string", "pattern": "^0x[0-9a-fA-F]{64}$"},
            "block_hash": {"type": "string", "pattern": "^0x[0-9a-fA-F]{64}$"},
            "log_index": {"type": "integer", "minimum": 0},
            "buyer": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
            "merchant": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
            "network": {"const": "eip155:31611"},
            "asset": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
            "amount_atomic": {"const": "10000000000000000"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["tx_hash", "settlement_count"],
          "properties": {
            "tx_hash": {"type": "string", "pattern": "^0x[0-9a-fA-F]{64}$"},
            "settlement_count": {"const": 1}
          }
        }
      ]
    },
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "title", "status", "command", "environment_names", "exit_code", "evidence", "omissions"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^A(0[1-9]|[12][0-9]|30)$"},
        "title": {"type": "string", "minLength": 1},
        "status": {"enum": ["NOT_RUN", "PASS", "FAIL", "BLOCKED_EXTERNAL"]},
        "started_at": {"$ref": "#/$defs/time"},
        "ended_at": {"$ref": "#/$defs/time"},
        "command": {"type": ["array", "null"], "items": {"type": "string"}},
        "environment_names": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}},
        "exit_code": {"type": ["integer", "null"]},
        "stdout_sha256": {"$ref": "#/$defs/sha256"},
        "stderr_sha256": {"$ref": "#/$defs/sha256"},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "omissions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "payment_evidence": {"$ref": "#/$defs/payment"}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "PASS"}}}, "then": {
          "required": ["started_at", "ended_at", "stdout_sha256", "stderr_sha256"],
          "properties": {"command": {"type": "array", "minItems": 1}, "exit_code": {"const": 0}, "evidence": {"minItems": 1}, "omissions": {"maxItems": 0}}
        }},
        {"if": {"properties": {"status": {"enum": ["NOT_RUN", "BLOCKED_EXTERNAL"]}}}, "then": {
          "properties": {"command": {"type": "null"}, "exit_code": {"type": "null"}, "evidence": {"maxItems": 0}, "omissions": {"minItems": 1}}
        }}
      ]
    }
  }
}
