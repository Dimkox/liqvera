{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.liqvera.invalid/mezo-evidence/v1/resources.schema.json",
  "title": "Liqvera public resource shapes",
  "description": "Closed response resources; F4 and F5 must enforce scope, state, integrity, receipt equality, and payment readiness at runtime.",
  "$defs": {
    "nonzero_address": {"type": "string", "minLength": 42, "maxLength": 42, "pattern": "^0x[0-9a-f]*[1-9a-f][0-9a-f]*(?![\\s\\S])"},
    "network": {"const": "eip155:31611"},
    "chain_id": {"const": 31611},
    "asset": {"const": "0x118917a40FAF1CD7a13dB0Ef56C86De7973Ac503"},
    "decimals": {"const": 18},
    "amount_atomic": {"const": "10000000000000000"},
    "price_musd": {"const": "0.01"},
    "preview": {
      "type": "object", "additionalProperties": false,
      "required": ["instrument_id", "side", "quantity_base", "snapshot_at", "snapshot_status", "limitations", "price_musd", "expires_at"],
      "properties": {
        "instrument_id": {"$ref": "quote-request.schema.json#/properties/instrument_id"},
        "side": {"$ref": "quote-request.schema.json#/properties/side"},
        "quantity_base": {"$ref": "primitives.schema.json#/$defs/quantity"},
        "snapshot_at": {"$ref": "primitives.schema.json#/$defs/timestamp"},
        "snapshot_status": {"const": "VALID_FOR_SNAPSHOT_CALCULATION"},
        "limitations": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1}},
        "price_musd": {"$ref": "#/$defs/price_musd"},
        "expires_at": {"$ref": "primitives.schema.json#/$defs/timestamp"}
      }
    },
    "terms": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "network", "chain_id", "asset", "decimals", "amount_atomic", "price_musd", "pay_to", "expected_payer", "expires_at"],
      "properties": {
        "version": {"const": "mee-evidence-terms/v1"},
        "network": {"$ref": "#/$defs/network"},
        "chain_id": {"$ref": "#/$defs/chain_id"},
        "asset": {"$ref": "#/$defs/asset"},
        "decimals": {"$ref": "#/$defs/decimals"},
        "amount_atomic": {"$ref": "#/$defs/amount_atomic"},
        "price_musd": {"$ref": "#/$defs/price_musd"},
        "pay_to": {"$ref": "#/$defs/nonzero_address"},
        "expected_payer": {"$ref": "#/$defs/nonzero_address"},
        "expires_at": {"$ref": "primitives.schema.json#/$defs/timestamp"}
      }
    },
    "retention": {
      "type": "object", "additionalProperties": false,
      "required": ["paid_days", "unpaid_grace_seconds", "ledger_days", "authorization_validity_floor", "deletion_must_not_enable_replay"],
      "properties": {
        "paid_days": {"type": "integer", "minimum": 7},
        "unpaid_grace_seconds": {"type": "integer", "minimum": 900},
        "ledger_days": {"type": "integer", "minimum": 30},
        "authorization_validity_floor": {"const": true},
        "deletion_must_not_enable_replay": {"const": true}
      }
    },
    "quote": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "request_id", "report_request_id", "quote_id", "report_id", "report_sha256", "bundle_sha256", "state", "preview", "terms", "retention"],
      "properties": {
        "schema": {"const": "mee-evidence-quote/v1"},
        "request_id": {"$ref": "primitives.schema.json#/$defs/id"},
        "report_request_id": {"$ref": "primitives.schema.json#/$defs/id"},
        "quote_id": {"$ref": "primitives.schema.json#/$defs/id"},
        "report_id": {"$ref": "primitives.schema.json#/$defs/id"},
        "report_sha256": {"$ref": "primitives.schema.json#/$defs/sha256"},
        "bundle_sha256": {"$ref": "primitives.schema.json#/$defs/sha256"},
        "state": {"type": "string", "enum": ["READY", "PAYMENT_PENDING", "PAYMENT_UNCERTAIN", "PAID", "EXPIRED", "MANUAL_REVIEW"]},
        "preview": {"$ref": "#/$defs/preview"},
        "terms": {"$ref": "#/$defs/terms"},
        "retention": {"$ref": "#/$defs/retention"}
      }
    },
    "status_location": {"type": "string", "pattern": "^/v1/report-requests/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"},
    "request_status": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["schema", "request_id", "report_request_id", "status_location", "state"], "properties": {"schema": {"const": "mee-evidence-request-status/v1"}, "request_id": {"$ref": "primitives.schema.json#/$defs/id"}, "report_request_id": {"$ref": "primitives.schema.json#/$defs/id"}, "status_location": {"$ref": "#/$defs/status_location"}, "state": {"const": "PREPARING"}}},
        {"type": "object", "additionalProperties": false, "required": ["schema", "request_id", "report_request_id", "status_location", "state", "quote_id"], "properties": {"schema": {"const": "mee-evidence-request-status/v1"}, "request_id": {"$ref": "primitives.schema.json#/$defs/id"}, "report_request_id": {"$ref": "primitives.schema.json#/$defs/id"}, "status_location": {"$ref": "#/$defs/status_location"}, "state": {"const": "READY"}, "quote_id": {"$ref": "primitives.schema.json#/$defs/id"}}},
        {"type": "object", "additionalProperties": false, "required": ["schema", "request_id", "report_request_id", "status_location", "state", "reason"], "properties": {"schema": {"const": "mee-evidence-request-status/v1"}, "request_id": {"$ref": "primitives.schema.json#/$defs/id"}, "report_request_id": {"$ref": "primitives.schema.json#/$defs/id"}, "status_location": {"$ref": "#/$defs/status_location"}, "state": {"const": "REJECTED"}, "reason": {"type": "string", "enum": ["INVALID_INPUT", "INVALID_DATASET", "STALE_SOURCE", "CLOCK_SKEW", "IDENTITY_UNVERIFIED", "IDENTITY_MISMATCH", "CROSSED_BOOK", "DEPTH_INSUFFICIENT", "UNSUPPORTED_INSTRUMENT", "SIMULATED_SOURCE"]}}},
        {"type": "object", "additionalProperties": false, "required": ["schema", "request_id", "report_request_id", "status_location", "state", "reason"], "properties": {"schema": {"const": "mee-evidence-request-status/v1"}, "request_id": {"$ref": "primitives.schema.json#/$defs/id"}, "report_request_id": {"$ref": "primitives.schema.json#/$defs/id"}, "status_location": {"$ref": "#/$defs/status_location"}, "state": {"const": "BUILD_FAILED"}, "reason": {"type": "string", "enum": ["SOURCE_UNAVAILABLE", "STORAGE_UNAVAILABLE", "ARTIFACT_INTEGRITY_FAILURE"]}}}
      ]
    },
    "receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "quote_id", "report_id", "payment_attempt_id", "report_sha256", "network", "chain_id", "asset", "amount_atomic", "payer", "pay_to", "tx_hash", "block_hash", "block_number", "log_index", "confirmed_at", "finality_policy_version"],
      "properties": {
        "schema": {"const": "mee-evidence-receipt/v1"},
        "quote_id": {"$ref": "primitives.schema.json#/$defs/id"},
        "report_id": {"$ref": "primitives.schema.json#/$defs/id"},
        "payment_attempt_id": {"$ref": "primitives.schema.json#/$defs/id"},
        "report_sha256": {"$ref": "primitives.schema.json#/$defs/sha256"},
        "network": {"$ref": "#/$defs/network"},
        "chain_id": {"$ref": "#/$defs/chain_id"},
        "asset": {"$ref": "#/$defs/asset"},
        "amount_atomic": {"$ref": "#/$defs/amount_atomic"},
        "payer": {"$ref": "#/$defs/nonzero_address"},
        "pay_to": {"$ref": "#/$defs/nonzero_address"},
        "tx_hash": {"type": "string", "pattern": "^0x[0-9a-f]{64}(?![\\s\\S])"},
        "block_hash": {"type": "string", "pattern": "^0x[0-9a-f]{64}(?![\\s\\S])"},
        "block_number": {"type": "integer", "minimum": 0},
        "log_index": {"type": "integer", "minimum": 0},
        "confirmed_at": {"$ref": "primitives.schema.json#/$defs/timestamp"},
        "finality_policy_version": {"type": "string", "minLength": 1}
      }
    },
    "paid_report": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "request_id", "report", "receipt"],
      "properties": {
        "schema": {"const": "mee-evidence-delivery/v1"},
        "request_id": {"$ref": "primitives.schema.json#/$defs/id"},
        "report": {"$ref": "report.schema.json"},
        "receipt": {"$ref": "#/$defs/receipt"}
      }
    },
    "capabilities": {
      "type": "object", "additionalProperties": false,
      "oneOf": [
        {"properties": {"payment_ready": {"const": false}, "blockers": {"minItems": 1}}},
        {"properties": {"payment_ready": {"const": true}, "source_mode": {"const": "live-public"}, "blockers": {"maxItems": 0}}}
      ],
      "required": ["schema", "request_id", "instrument_id", "instrument_label", "network", "asset", "decimals", "price_musd", "amount_atomic", "source_mode", "limitations", "payment_ready", "blockers"],
      "properties": {
        "schema": {"const": "mee-evidence-capabilities/v1"},
        "request_id": {"$ref": "primitives.schema.json#/$defs/id"},
        "instrument_id": {"$ref": "quote-request.schema.json#/properties/instrument_id"},
        "instrument_label": {"const": "Hyperliquid BTC linear perpetual"},
        "network": {"$ref": "#/$defs/network"},
        "asset": {"$ref": "#/$defs/asset"},
        "decimals": {"$ref": "#/$defs/decimals"},
        "price_musd": {"$ref": "#/$defs/price_musd"},
        "amount_atomic": {"$ref": "#/$defs/amount_atomic"},
        "source_mode": {"type": "string", "enum": ["fixture", "live-public"]},
        "limitations": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1}},
        "payment_ready": {"type": "boolean"},
        "blockers": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "reasons.schema.json"}}
      }
    },
    "health": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "request_id", "status"],
      "properties": {
        "schema": {"const": "mee-evidence-health/v1"},
        "request_id": {"$ref": "primitives.schema.json#/$defs/id"},
        "status": {"const": "alive"}
      }
    },
    "readiness": {
      "type": "object", "additionalProperties": false,
      "oneOf": [
        {"properties": {"ready": {"const": false}}, "oneOf": [
          {"properties": {"payment_ready": {"const": false}}},
          {"properties": {"payment_ready": {"const": true}, "blockers": {"maxItems": 0}}, "oneOf": [
            {"properties": {"storage_ready": {"const": false}}},
            {"properties": {"storage_ready": {"const": true}, "configuration_ready": {"const": false}}},
            {"properties": {"storage_ready": {"const": true}, "configuration_ready": {"const": true}, "integration_ready": {"const": false}}}
          ]}
        ]},
        {"properties": {"ready": {"const": true}, "storage_ready": {"const": true}, "configuration_ready": {"const": true}, "integration_ready": {"const": true}, "payment_ready": {"const": true}, "blockers": {"maxItems": 0}}}
      ],
      "required": ["schema", "request_id", "ready", "storage_ready", "configuration_ready", "integration_ready", "payment_ready", "blockers"],
      "properties": {
        "schema": {"const": "mee-evidence-readiness/v1"},
        "request_id": {"$ref": "primitives.schema.json#/$defs/id"},
        "ready": {"type": "boolean"},
        "storage_ready": {"type": "boolean"},
        "configuration_ready": {"type": "boolean"},
        "integration_ready": {"type": "boolean"},
        "payment_ready": {"type": "boolean"},
        "blockers": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "reasons.schema.json"}}
      }
    }
  }
}
