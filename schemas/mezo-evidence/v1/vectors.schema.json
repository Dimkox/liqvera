{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.liqvera.invalid/mezo-evidence/v1/vectors.schema.json",
  "description": "Closed F2 obligations. Embedded request/dataset/claim JSON is checked by the contract oracle. No vector is runtime acceptance evidence.",
  "$defs": {
    "assertions_F3": {
      "type": "string",
      "enum": [
        "report_builder_matches_exact_sweep",
        "fixture_is_not_live_sale",
        "insufficient_depth_never_sells_partial",
        "dataset_policy_rejects_invalid_evidence",
        "live_outage_never_uses_fixture",
        "report_provenance_required",
        "canonical_report_bytes_reproduce"
      ]
    },
    "assertions_F4": {
      "type": "string",
      "enum": [
        "invalid_request_never_creates_quote",
        "canonical_retries_one_quote",
        "twenty_concurrent_retries_one_quote",
        "idempotency_body_conflict",
        "idempotency_scope_isolation",
        "sibling_scope_never_reads_body",
        "capability_required_for_access",
        "unpaid_read_returns_sdk_402",
        "missing_artifact_prevents_payment",
        "paid_artifact_loss_requires_recovery_without_charge"
      ]
    },
    "assertions_F5": {
      "type": "string",
      "enum": [
        "atomic_amount_matches_all_layers",
        "invalid_authorization_never_entitles",
        "sdk_identity_deduplicates_reencoding",
        "receipt_log_bound_to_authorization",
        "verify_alone_never_delivers",
        "unknown_never_resubmits",
        "crash_recovery_never_double_charges",
        "lost_response_reuses_entitlement",
        "expiry_blocks_new_payment_only",
        "late_confirmation_delivers_original",
        "paid_repeat_read_never_settles",
        "current_confirmation_required_for_delivery",
        "retention_covers_authorization_validity",
        "deletion_cannot_enable_replay"
      ]
    },
    "dataset_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_instrument",
        "returned_instrument",
        "quantity_unit",
        "multiplier",
        "source_mode",
        "age_ms",
        "metadata_age_ms",
        "metadata_now_ms",
        "metadata_valid_from_ms",
        "metadata_valid_until_ms",
        "evidence_text",
        "evidence_sha256",
        "upstream_available",
        "bids",
        "asks",
        "side",
        "quantity_base"
      ],
      "properties": {
        "requested_instrument": {
          "type": "string",
          "minLength": 1
        },
        "returned_instrument": {
          "type": "string",
          "minLength": 1
        },
        "quantity_unit": {
          "type": "string",
          "minLength": 1
        },
        "multiplier": {
          "type": "string",
          "minLength": 1
        },
        "source_mode": {
          "type": "string",
          "enum": [
            "fixture",
            "live-public"
          ]
        },
        "age_ms": {
          "type": "integer"
        },
        "metadata_age_ms": {
          "type": "integer",
          "minimum": 0
        },
        "metadata_now_ms": {
          "type": "integer",
          "minimum": 0
        },
        "metadata_valid_from_ms": {
          "type": "integer",
          "minimum": 0
        },
        "metadata_valid_until_ms": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_text": {
          "type": "string",
          "minLength": 1
        },
        "evidence_sha256": {
          "oneOf": [
            {
              "$ref": "primitives.schema.json#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "upstream_available": {
          "type": "boolean"
        },
        "bids": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 2,
            "maxItems": 2
          },
          "minItems": 1,
          "maxItems": 20
        },
        "asks": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 2,
            "maxItems": 2
          },
          "minItems": 1,
          "maxItems": 20
        },
        "side": {
          "type": "string",
          "enum": [
            "BUY",
            "SELL"
          ]
        },
        "quantity_base": {
          "$ref": "primitives.schema.json#/$defs/quantity"
        }
      }
    },
    "candidate_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network",
        "asset",
        "amount_atomic",
        "pay_to",
        "payer",
        "signature_valid",
        "authorization_expired",
        "authorization_reused",
        "same_authorization_different_encoding"
      ],
      "properties": {
        "network": {
          "type": "string",
          "minLength": 1
        },
        "asset": {
          "type": "string",
          "minLength": 1
        },
        "amount_atomic": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ]
        },
        "pay_to": {
          "type": "string",
          "minLength": 1
        },
        "payer": {
          "type": "string",
          "minLength": 1
        },
        "signature_valid": {
          "type": "boolean"
        },
        "authorization_expired": {
          "type": "boolean"
        },
        "authorization_reused": {
          "type": "boolean"
        },
        "same_authorization_different_encoding": {
          "type": "boolean"
        }
      }
    }
  },
