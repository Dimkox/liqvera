{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$defs":{
    "platform":{"type":"object","additionalProperties":false,"required":["os","architecture"],"properties":{"os":{"const":"linux"},"architecture":{"const":"amd64"}}},
    "digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "descriptor":{"type":"object","additionalProperties":false,"required":["mediaType","digest","size"],"properties":{"mediaType":{"type":"string"},"digest":{"$ref":"#/$defs/digest"},"size":{"type":"integer","minimum":0}}},
    "response":{"type":"object","additionalProperties":false,"required":["url","status","content_type","docker_content_digest","body_sha256","body_size"],"properties":{"url":{"type":"string","pattern":"^https://"},"status":{"type":"integer"},"content_type":{"type":"string"},"docker_content_digest":{"type":"string"},"body_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"body_size":{"type":"integer","minimum":0}}}
  },
  "type":"object","additionalProperties":false,
  "required":["schema_version","authority","status","not_host_receipt","created_at_utc","source_image","repository","inputs","command","tool","acquisitions","dual_acquisition","local_verification","oci_layout_verification","limitations","readiness"],
  "properties":{
    "schema_version":{"const":"oci-evidence-v2"},"authority":{"const":"NONE"},"status":{"const":"LOCAL_OCI_EVIDENCE_ONLY"},"not_host_receipt":{"const":true},"created_at_utc":{"type":"string"},"source_image":{"const":"docker.io/rhysd/actionlint@sha256:9d36088643581e728c969f35141f88139fec77280b2be23c1f66f8e40e1025e7"},
    "repository":{"type":"object","additionalProperties":false,"required":["origin","commit","tree"],"properties":{"origin":{"type":"string"},"commit":{"type":"string","pattern":"^[0-9a-f]{40}$"},"tree":{"type":"string","pattern":"^[0-9a-f]{40}$"}}},
    "inputs":{"type":"object","additionalProperties":false,"required":["policy_sha256","closure_sha256","archive_name","resolved_path_diagnostic","archive_post_sha256"],"properties":{"policy_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"closure_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"archive_name":{"const":"actionlint-linux-amd64.tar"},"resolved_path_diagnostic":{"type":"string"},"archive_post_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}},
    "command":{"type":"object","additionalProperties":false,"required":["argv","sha256"],"properties":{"argv":{"type":"array","items":{"type":"string"}},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}},
    "tool":{"type":"object","additionalProperties":false,"required":["python","verifier_source_sha256","builder_source_sha256","independent_verifier_sha256","schema_sha256"],"properties":{"python":{"type":"string"},"verifier_source_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"builder_source_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"independent_verifier_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"schema_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}},
    "acquisitions":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"object","additionalProperties":false,"required":["session_id","acquired_at_utc","repository","manifest_sha256","manifest_media_type","config_sha256","platform","layers","responses","auth"],"properties":{"session_id":{"type":"string"},"acquired_at_utc":{"type":"string"},"repository":{"const":"rhysd/actionlint"},"manifest_sha256":{"$ref":"#/$defs/digest"},"manifest_media_type":{"const":"application/vnd.oci.image.manifest.v1+json"},"config_sha256":{"$ref":"#/$defs/digest"},"platform":{"$ref":"#/$defs/platform"},"layers":{"type":"array","items":{"$ref":"#/$defs/descriptor"}},"responses":{"type":"array","items":{"$ref":"#/$defs/response"}},"auth":{"type":"object","additionalProperties":false,"required":["realm","service","scope","token_persisted","token_response_status"],"properties":{"realm":{"const":"https://auth.docker.io/token"},"service":{"const":"registry.docker.io"},"scope":{"const":"repository:rhysd/actionlint:pull"},"token_persisted":{"const":false},"token_response_status":{"const":200}}}}}},
    "dual_acquisition":{"type":"object","additionalProperties":false,"required":["equal","first_session","second_session"],"properties":{"equal":{"const":true},"first_session":{"type":"string"},"second_session":{"type":"string"}}},
    "local_verification":{"type":"object","additionalProperties":false,"required":["archive_sha256","archive_identity","platform","config_digest","diff_ids","layers","whiteouts","rootfs_sha256","rootfs_entries","actionlint"],"properties":{"archive_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"archive_identity":{"type":"object","additionalProperties":false,"required":["size","device","inode","links"],"properties":{"size":{"type":"integer","minimum":0},"device":{"type":"integer","minimum":0,"description":"producer-local diagnostic; not a verifier-host equality field"},"inode":{"type":"integer","minimum":0,"description":"producer-local diagnostic; not a verifier-host equality field"},"links":{"const":1}}},"platform":{"$ref":"#/$defs/platform"},"config_digest":{"$ref":"#/$defs/digest"},"diff_ids":{"type":"array","items":{"$ref":"#/$defs/digest"}},"layers":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["ordinal","name","digest","diff_id","compressed_size","uncompressed_size"],"properties":{"ordinal":{"type":"integer"},"name":{"type":"string"},"digest":{"$ref":"#/$defs/digest"},"diff_id":{"$ref":"#/$defs/digest"},"compressed_size":{"type":"integer"},"uncompressed_size":{"type":"integer"}}}},"whiteouts":{"type":"array","items":{"type":"string"}},"rootfs_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"rootfs_entries":{"type":"integer"},"actionlint":{"type":"object","additionalProperties":false,"required":["path","mode","size","sha256","elf","version_execution"],"properties":{"path":{"const":"usr/local/bin/actionlint"},"mode":{"const":"0755"},"size":{"type":"integer"},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"elf":{"type":"object","additionalProperties":false,"required":["class","machine"],"properties":{"class":{"const":"ELF64"},"machine":{"const":"x86-64"}}},"version_execution":{"const":"PENDING_UNTIL_ROOTLESS_HOST_SMOKE"}}}}},
    "oci_layout_verification":{"type":"object","additionalProperties":false,"required":["layout_version","manifest_digest","platform","descriptors"],"properties":{"layout_version":{"const":"1.0.0"},"manifest_digest":{"$ref":"#/$defs/digest"},"platform":{"$ref":"#/$defs/platform"},"descriptors":{"type":"array","items":{"$ref":"#/$defs/descriptor"}}}},
    "limitations":{"type":"array","minItems":3,"maxItems":3,"uniqueItems":true,"items":{"enum":["PENDING_UNTIL_ROOTLESS_HOST_SMOKE","NOT_A_HOST_RECEIPT","ZERO_SENTINEL_UNCHANGED"]}},"readiness":{"const":"NOT_READY_FOR_HOST_APPLY"}
  }
}
