{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-materialization-observation-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","authority","repository","pr_number","head_sha","head_tree","base_sha","controller_sha","controller_tree","workflow_path","workflow_blob_sha","action_set_sha256","input_sha256","archive_sha256","member_policy_sha256","approval_comment_id","approval_comment_url","approval_owner_id","approval_owner_login","approval_body_sha256","approval_nonce","approval_created_at","cleanup"],
  "properties": {
    "schema_version": {"const": "source-materialization-observation-v1"},
    "authority": {"const": "NONE"},
    "repository": {"type":"string","pattern":"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$","minLength":3,"maxLength":200},
    "pr_number": {"type":"integer","minimum":1},
    "head_sha": {"$ref":"#/$defs/sha1"}, "head_tree": {"$ref":"#/$defs/sha1"},
    "base_sha": {"$ref":"#/$defs/sha1"}, "controller_sha": {"$ref":"#/$defs/sha1"},
    "controller_tree": {"$ref":"#/$defs/sha1"}, "workflow_blob_sha": {"$ref":"#/$defs/sha1"},
    "workflow_path": {"const":".github/workflows/validate-pr-on-claw.yml"},
    "action_set_sha256": {"$ref":"#/$defs/sha256"}, "input_sha256": {"$ref":"#/$defs/sha256"},
    "archive_sha256": {"$ref":"#/$defs/sha256"}, "member_policy_sha256": {"$ref":"#/$defs/sha256"},
    "approval_comment_id":{"type":"integer","minimum":1}, "approval_comment_url":{"type":"string","pattern":"^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/pull/[1-9][0-9]*#issuecomment-[1-9][0-9]*$"},
    "approval_owner_id":{"type":"integer","minimum":1}, "approval_owner_login":{"type":"string","minLength":1},
    "approval_body_sha256":{"$ref":"#/$defs/sha256"}, "approval_nonce":{"type":"string","pattern":"^[A-Za-z0-9_-]{43}$"},
    "approval_created_at":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "cleanup": {"type":"object","additionalProperties":false,"required":["intent","outcome"],"properties":{"intent":{"const":"REMOVE_ALL"},"outcome":{"const":"REMOVED"}}}
  },
  "$defs": {"sha1":{"type":"string","pattern":"^[0-9a-f]{40}$"},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}
}
