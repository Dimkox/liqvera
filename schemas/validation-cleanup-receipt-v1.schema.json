{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,"required":["schema_version","repository","head_sha","run_id","run_attempt","job","shard","owned_resources","workspace_removed","output_secrets_removed","absence_proven","validation_receipt_sha256","status"],"properties":{"schema_version":{"const":"validation-cleanup-receipt-v1"},"repository":{"type":"string","pattern":"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},"head_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},"run_id":{"type":"integer","minimum":1},"run_attempt":{"type":"integer","minimum":1},"job":{"type":"string","pattern":"^[a-z0-9-]{1,64}$"},"shard":{"type":"string","pattern":"^[a-z0-9-]{1,64}$"},"owned_resources":{"type":"array","maxItems":256,"uniqueItems":true,"items":{"type":"string","maxLength":200}},"workspace_removed":{"const":true},"output_secrets_removed":{"const":true},"absence_proven":{"const":true},"validation_receipt_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"status":{"const":"CLEANUP_VERIFIED"}}}
