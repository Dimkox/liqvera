{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,"required":["schema_version","repository","pr_number","head_sha","head_tree","controller_sha","controller_tree","workflow_blob_sha","archive_sha256","policy_sha256","image_digest","command_set_sha256","run_id","run_attempt","job","shard","result_sha256","status"],"properties":{"schema_version":{"const":"validation-receipt-v1"},"repository":{"type":"string","pattern":"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},"pr_number":{"type":"integer","minimum":1},"head_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},"head_tree":{"type":"string","pattern":"^[0-9a-f]{40}$"},"controller_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},"controller_tree":{"type":"string","pattern":"^[0-9a-f]{40}$"},"workflow_blob_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},"archive_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"policy_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"image_digest":{"type":"string","pattern":"^[^@\\s]+@sha256:[0-9a-f]{64}$"},"command_set_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"run_id":{"type":"integer","minimum":1},"run_attempt":{"type":"integer","minimum":1},"job":{"type":"string","pattern":"^[a-z0-9-]{1,64}$"},"shard":{"type":"string","pattern":"^[a-z0-9-]{1,64}$"},"result_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"status":{"const":"VALIDATION_SUCCEEDED"}}}
